# Supabase · Project Settings → Data API
# URL del proyecto (empieza por https:// y termina en .supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key · Project Settings → API Keys → service_role
# SOLO servidor. Nunca la expongas al navegador (no usar NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave secreta que usa el Atajo de iOS en la cabecera x-api-key
# Invéntala con: openssl rand -hex 24
API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria